{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "functions": {
    "app/api/aip/state/route.ts": {
      "maxDuration": 60
    },
    "app/api/aip/cron/outbox/route.ts": {
      "maxDuration": 300
    },
    "app/api/aip/cron/agents/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/aip/cron/outbox",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/aip/cron/agents",
      "schedule": "7 * * * *"
    }
  ]
}
