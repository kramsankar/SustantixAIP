# Sustantix AIP web host. Copy to .env.local for local development.
# Never commit real values. On Vercel set these under Project > Settings > Environment Variables.

# Supabase project (Settings > API). Used server-side only by this app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS: used solely for aip.license_clock and aip.audit_log appends.
SUPABASE_SERVICE_ROLE_KEY=

# SXL1 license token issued for this deployment's domain
# (sx-license issue --platform vercel --domain <host> ...).
AIP_LICENSE_KEY=

# Optional signed SXR1 revocation list (sx-license revoke ...).
AIP_LICENSE_REVOCATION=

# Optional, self-hosted only: trust x-forwarded-host / x-forwarded-for set by your own
# reverse proxy. Leave unset on Vercel (trusted automatically there).
# AIP_TRUST_PROXY=1
